{
  "name": "hackerterm",
  "version": "0.0.1",
  "description": "HackerTerm: terminal + database + file manager, Electron UI over a Rust core",
  "author": "HackerTerm",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "main": "out/main/index.js",
  "scripts": {
    "build:native": "pnpm --filter ht-node build",
    "test:native": "pnpm --filter ht-node test",
    "proto:ts": "mkdir -p src/ui/common/protocol && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/ui/common/protocol --ts_proto_opt=esModuleInterop=true,outputJsonMethods=false,outputPartialMethods=false,useOptionals=messages -I proto proto/hackerterm.proto",
    "lint": "eslint src",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "electron-builder --win --x64",
    "package:linux": "electron-builder --linux --x64",
    "bench:arrow": "tsx bench/arrow.ts",
    "test": "vitest run src"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ht-node": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "apache-arrow": "^21.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "ts-proto": "^2.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.hackerterm.desktop",
    "productName": "HackerTerm",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*",
      {
        "from": "crates/ht-node",
        "to": "node_modules/ht-node",
        "filter": [
          "index.js",
          "package.json",
          "*.node"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    }
  }
}
